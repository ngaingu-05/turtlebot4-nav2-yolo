#!/usr/bin/env python3
import os
import time
import cv2
import mediapipe as mp
import rclpy
from rclpy.node import Node
from std_msgs.msg import String
from gesture_core import WaveDetector


class Recognizer(Node):
    def __init__(self):
        super().__init__('gesture_recognition_node')
        self.declare_parameter('model', os.path.expanduser('~/turtlebot4/models/gesture_recognizer.task'))
        self.declare_parameter('camera', 0)
        self.declare_parameter('confidence', 0.65)
        self.pub = self.create_publisher(String, '/detected_gesture', 1)
        self.state = 'IDLE'
        self.create_subscription(String, '/behavior_status', self.status, 1)
        options = mp.tasks.vision.GestureRecognizerOptions(
            base_options=mp.tasks.BaseOptions(model_asset_path=self.get_parameter('model').value),
            running_mode=mp.tasks.vision.RunningMode.VIDEO, num_hands=1)
        self.engine = mp.tasks.vision.GestureRecognizer.create_from_options(options)
        self.cap = cv2.VideoCapture(self.get_parameter('camera').value)
        if not self.cap.isOpened():
            self.engine.close()
            raise RuntimeError('Cannot open webcam')
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        self.wave = WaveDetector()
        self.last_ms = 0
        self.create_timer(1 / 20, self.frame)

    def status(self, msg):
        self.state = msg.data

    def frame(self):
        ok, frame = self.cap.read()
        if not ok:
            self.pub.publish(String(data='None'))
            return
        frame = cv2.flip(frame, 1)
        now = time.monotonic()
        self.last_ms = max(self.last_ms + 1, int(now * 1000))
        result = self.engine.recognize_for_video(mp.Image(
            image_format=mp.ImageFormat.SRGB, data=cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)), self.last_ms)
        label, raw_label, score = 'None', 'None', 0.0
        if result.gestures and result.gestures[0]:
            top = result.gestures[0][0]
            score = top.score
            raw_label = top.category_name
            if score >= self.get_parameter('confidence').value:
                label = top.category_name
        x = result.hand_landmarks[0][0].x if result.hand_landmarks else 0.0
        label = self.wave.update(label, x, now)
        self.pub.publish(String(data=label))
        for hand in result.hand_landmarks:
            for p in hand:
                cv2.circle(frame, (int(p.x * frame.shape[1]), int(p.y * frame.shape[0])), 3, (0, 255, 0), -1)
        cv2.putText(frame, f'{label}  {score:.2f}', (15, 30), cv2.FONT_HERSHEY_SIMPLEX, .8, (0, 255, 0), 2)
        cv2.putText(frame, self.state, (15, 65), cv2.FONT_HERSHEY_SIMPLEX, .6, (0, 255, 255), 2)
        if not result.hand_landmarks:
            cv2.putText(frame, 'SHOW FULL HAND IN FRAME', (15, 100),
                        cv2.FONT_HERSHEY_SIMPLEX, .65, (0, 0, 255), 2)
        elif label == 'None':
            cv2.putText(frame, f'Raw: {raw_label} {score:.2f} - hold hand clearly', (15, 100),
                        cv2.FONT_HERSHEY_SIMPLEX, .5, (0, 200, 255), 1)
        if self.state.startswith('SELECTED:'):
            hint = 'CONFIRM: thumb up (within 5 seconds)'
        elif self.state.startswith('RUNNING:'):
            hint = 'Keep hand visible | Open palm: STOP'
        else:
            hint = 'SELECT: 1 finger / 2 fingers / wave'
        cv2.putText(frame, hint, (15, frame.shape[0] - 20),
                    cv2.FONT_HERSHEY_SIMPLEX, .55, (0, 255, 255), 2)
        cv2.imshow('Lab 6 - Hand gestures', frame)
        cv2.waitKey(1)  # GUI event processing only; no keyboard motion commands
        if cv2.getWindowProperty('Lab 6 - Hand gestures', cv2.WND_PROP_VISIBLE) < 1:
            raise KeyboardInterrupt


def main():
    rclpy.init()
    node = None
    try:
        node = Recognizer()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            if rclpy.ok():
                node.pub.publish(String(data='None'))
            node.cap.release()
            node.engine.close()
            node.destroy_node()
        cv2.destroyAllWindows()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
