#!/usr/bin/env python3
import math
import time
import rclpy
from rclpy.node import Node
from rclpy.clock import Clock, ClockType
from rclpy.qos import QoSProfile, ReliabilityPolicy
from geometry_msgs.msg import Twist, TwistStamped
from sensor_msgs.msg import LaserScan
from std_msgs.msg import String
from gesture_core import Controller


class Behavior(Node):
    def __init__(self):
        super().__init__('robot_behavior_node')
        self.declare_parameter('stamped', True)
        self.declare_parameter('require_scan', True)
        self.stamped = self.get_parameter('stamped').value
        self.core = Controller()
        self.scan_time, self.clear = float('-inf'), False
        self.pub = self.create_publisher(TwistStamped if self.stamped else Twist, '/cmd_vel', 1)
        self.status = self.create_publisher(String, '/behavior_status', 1)
        self.create_subscription(String, '/detected_gesture', self.gesture, 1)
        self.create_subscription(LaserScan, '/scan', self.scan,
                                 QoSProfile(depth=1, reliability=ReliabilityPolicy.BEST_EFFORT))
        self.create_timer(0.05, self.tick, clock=Clock(clock_type=ClockType.STEADY_TIME))

    def sim(self):
        return self.get_clock().now().nanoseconds / 1e9

    def gesture(self, msg):
        self.core.receive(msg.data, time.monotonic(), self.sim())
        if msg.data in ('Open_Palm', 'Closed_Fist'):
            self.publish(0., 0.)

    def scan(self, msg):
        self.scan_time = time.monotonic()
        # Fail closed on NaN, invalid/zero measurements; +inf means no return.
        valid = [r for r in msg.ranges if math.isfinite(r) and msg.range_min <= r <= msg.range_max]
        invalid = any(math.isnan(r) or r < msg.range_min or r == -math.inf for r in msg.ranges)
        self.clear = bool(msg.ranges) and not invalid and (not valid or min(valid) > 0.55)

    def publish(self, linear, angular):
        msg = TwistStamped() if self.stamped else Twist()
        twist = msg.twist if self.stamped else msg
        if self.stamped:
            msg.header.stamp = self.get_clock().now().to_msg()
            msg.header.frame_id = 'base_link'
        twist.linear.x, twist.angular.z = float(linear), float(angular)
        self.pub.publish(msg)

    def tick(self):
        now = time.monotonic()
        if self.get_parameter('require_scan').value and (now - self.scan_time > 1.0 or not self.clear):
            self.core.stop('SCAN BLOCKED / STALE')
        self.publish(*self.core.velocity(now, self.sim()))
        self.status.publish(String(data=self.core.status))


def main():
    rclpy.init()
    node = Behavior()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            node.publish(0., 0.)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
